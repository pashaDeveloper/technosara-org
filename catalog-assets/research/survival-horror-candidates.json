          "CommonsMetadataExtension": {
            "value": 1.2,
            "source": "extension",
            "hidden": ""
          },
          "Categories": {
            "value": "Media from YouTube|SCP – Containment Breach|Videos from YouTube|License review needed (video)|Creative Commons Attribution 4.0 missing SDC copyright license|Creative Commons Attribution missing SDC copyright status|Uploaded with video2commons|Videos in English|Files without recognized closed captioning|Videos of short films from 2025",
            "source": "commons-categories",
            "hidden": ""
